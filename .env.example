# Server-side only. Set these as Supabase secrets, never in the app:
#   supabase secrets set MUSE_API_KEY=... MUSE_BASE_URL=... MUSE_MODEL=...
MUSE_BASE_URL=https://REPLACE_WITH_MUSE_SPARK_BASE_URL/v1
MUSE_API_KEY=
MUSE_MODEL=REPLACE_WITH_MUSE_SPARK_MODEL_ID

# Optional: agent requests allowed per user per day (default 80). Set as a Supabase secret.
# AGENT_DAILY_LIMIT=80

# Web search uses Muse's built-in web_search tool (same key). Optional: another model for it.
# SEARCH_MODEL=

# Voice uses the same base URL and key as the chat. Set these only if they differ:
# ASR_MODEL=muse-voice-transcribe-1.0
# ASR_BASE_URL=https://api.meta.ai/v1

# Daily budget for the WHOLE demo (all users together). Past it, every request answers demo_at_capacity.
# supabase secrets set AGENT_GLOBAL_DAILY_LIMIT=1000
# AGENT_GLOBAL_DAILY_LIMIT=1000

# Pictures the agent makes use Muse Image (same key). Optional: another model id.
# IMAGE_MODEL=muse-image-1.0

# Originals (photos, PDFs) are deleted after they are read. Set true to keep them in the private uploads bucket.
# KEEP_ORIGINALS=false
